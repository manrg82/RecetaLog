<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logoapp"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logoapp_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.RecetaLog">

        <activity
            android:name=".view.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.RecetasActivity"
            android:exported="false"
            android:parentActivityName=".view.MainActivity" />

        <activity
            android:name=".view.AddRecetaActivity"
            android:exported="false"
            android:parentActivityName=".view.RecetasActivity" />

        <activity
            android:name=".view.DetalleRecetaActivity"
            android:exported="false"
            android:parentActivityName=".view.RecetasActivity" />

        <activity
            android:name=".view.OpcionesActivity"
            android:exported="false"
            android:parentActivityName=".view.MainActivity" />

        <activity
            android:name=".view.LicenciasActivity"
            android:exported="false"
            android:parentActivityName=".view.OpcionesActivity" />

    </application>

</manifest>