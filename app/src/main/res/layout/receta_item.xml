<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgReceta"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@mipmap/logoapp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtNombreReceta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgReceta"
            app:layout_constraintTop_toTopOf="@id/imgReceta"
            tools:text="Nombre de la Receta" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupEtiquetas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            app:chipSpacingHorizontal="4dp"
            app:chipSpacingVertical="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgReceta"
            app:layout_constraintTop_toBottomOf="@id/txtNombreReceta"
            app:singleLine="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVerdura"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_verdura"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCarne"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_carne"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPescado"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_pescado"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPostre"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_postre"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLactosa"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_lactosa"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFruta"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_fruta"
                android:textSize="12sp"
                android:visibility="gone" />

        </com.google.android.material.chip.ChipGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
